<resources>
    <style name="Theme.SimpleCamera" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/camera_bg</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorAccent">@color/accent</item>
    </style>
    <style name="Theme.SimpleCamera.Settings" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/setting_title_bg</item>
        <item name="colorPrimaryDark">@color/setting_title_bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/camera_bg</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>
</resources>
