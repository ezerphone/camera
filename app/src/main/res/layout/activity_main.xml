<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1B1B1B"
    android:layoutDirection="ltr">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Quick review after a photo: same full-screen box as the preview (FIT_CENTER, no distortion),
         placed BEHIND the controls so the buttons stay usable -->
    <ImageView
        android:id="@+id/reviewImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_focus"
        android:visibility="gone" />

    <!-- Top bar: settings (left) ... flash (right) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingTop="8dp"
        android:paddingEnd="11dp">

        <ImageView
            android:id="@+id/btnGear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="11dp"
            android:src="@drawable/ic_gear_hex" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnFlash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="11dp"
            android:src="@drawable/ic_flash_status_off" />
    </LinearLayout>

    <!-- Right-side status indicators -->
    <LinearLayout
        android:id="@+id/indicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/recTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_pill"
        android:drawableStart="@drawable/bg_rec_dot"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/zoomLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="108dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="96sp"
        android:visibility="gone" />

    <!-- Pro controls -->
    <LinearLayout
        android:id="@+id/proPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="138dp"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/proEvLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EV"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/proEv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/proIsoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ISO"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/proIso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/proSsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shutter"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/proSs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />
    </LinearLayout>

    <!-- Mode strip (swipe / tap): filled in code -->
    <LinearLayout
        android:id="@+id/modeStrip"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="90dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <!-- Bottom bar: switch camera | shutter | thumbnail -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnSwitch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="46dp"
            android:padding="5dp"
            android:src="@drawable/ic_switch_camera_normal" />

        <ImageView
            android:id="@+id/btnPause"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="42dp"
            android:src="@drawable/ic_pause_recording"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnShutter"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shutter_photo" />

        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="46dp"
            android:background="@drawable/bg_thumb"
            android:padding="2dp"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- Screen flash overlay (selfie) -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
