<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="אחסון">
        <Preference
            app:key="save_location"
            app:title="מיקום שמירה"
            app:summary="DCIM/Camera (ברירת מחדל)" />
        <Preference
            app:key="reset_location"
            app:title="חזרה למיקום ברירת מחדל" />
    </PreferenceCategory>

    <PreferenceCategory app:title="צילום">
        <ListPreference
            app:key="timer" app:title="טיימר עצמי" app:defaultValue="0"
            app:entries="@array/timer_entries" app:entryValues="@array/timer_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="aspect" app:title="גודל תמונה" app:defaultValue="full"
            app:entries="@array/aspect_entries" app:entryValues="@array/aspect_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="photo_quality" app:title="איכות צילום" app:defaultValue="high"
            app:entries="@array/pq_entries" app:entryValues="@array/pq_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="wb" app:title="איזון לבן" app:defaultValue="auto"
            app:entries="@array/wb_entries" app:entryValues="@array/wb_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="scene" app:title="מצב סצנה" app:defaultValue="off"
            app:entries="@array/scene_entries" app:entryValues="@array/scene_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="antibanding" app:title="אנטי-פליקר" app:defaultValue="auto"
            app:entries="@array/ab_entries" app:entryValues="@array/ab_values"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="nr" app:title="הפחתת רעש (איכות גבוהה)" app:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="וידאו">
        <ListPreference
            app:key="video_quality" app:title="איכות וידאו" app:defaultValue="FHD"
            app:entries="@array/vq_entries" app:entryValues="@array/vq_values"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="eis" app:title="ייצוב תמונה (EIS)" app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="mic" app:title="הקלטת קול" app:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory app:title="תיקון איכות">
        <SwitchPreferenceCompat
            app:key="enhance"
            app:title="תיקון איכות אוטומטי אחרי צילום"
            app:summary="שומר עותק מתוקן לצד המקור (איזון רמות, הבהרה וחידוד)."
            app:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
